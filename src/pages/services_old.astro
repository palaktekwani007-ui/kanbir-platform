

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Services | Kanbir Solutions</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<style>

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

:root{
--bg:#020617;
--card:#0f172a;
--card2:#111c35;
--primary:#2563eb;
--primary-light:#60a5fa;
--text:#ffffff;
--muted:#94a3b8;
--border:rgba(255,255,255,.08);
}

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Inter',sans-serif;
}

html{
scroll-behavior:smooth;
}

body{
background:var(--bg);
color:var(--text);
overflow-x:hidden;
}

/* HERO */

.hero{
position:relative;
min-height:100vh;
display:flex;
align-items:center;
padding:0 8%;
overflow:hidden;
}

.hero::before{
content:"";
position:absolute;
width:700px;
height:700px;

background:
radial-gradient(
circle,
rgba(96,165,250,.35),
transparent 60%
);

top:-200px;
right:-150px;

filter:blur(40px);
pointer-events:none;
}

.hero::after{
content:"";
position:absolute;
width:600px;
height:600px;

background:
radial-gradient(
circle,
rgba(14,165,233,.18),
transparent 60%
);

bottom:-250px;
left:-150px;

filter:blur(60px);
pointer-events:none;
}

.hero-grid{
position:relative;
z-index:2;
display:grid;
grid-template-columns:1.2fr 1fr;
gap:80px;
align-items:center;
width:100%;
}

.badge{
display:inline-flex;
padding:12px 22px;
border-radius:999px;
background:linear-gradient(
135deg,
rgba(191,219,254,0.15),
rgba(147,197,253,0.08)
);
backdrop-filter:blur(20px);
border:1px solid rgba(96,165,250,0.3);
margin-bottom:30px;
font-weight:600;
animation:slideInLeft 0.8s ease-out;
box-shadow:0 0 30px rgba(37,99,235,0.1), inset 0 1px 2px rgba(255,255,255,0.1);
transition:all 0.4s ease;
}

.badge:hover{
background:linear-gradient(
135deg,
rgba(191,219,254,0.25),
rgba(147,197,253,0.15)
);
box-shadow:0 0 40px rgba(37,99,235,0.2), inset 0 1px 2px rgba(255,255,255,0.15);
border-color:rgba(96,165,250,0.5);
}

/* ANIMATIONS */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-40px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes textGlow {
  0%, 100% {
    text-shadow: 0 0 20px rgba(37,99,235,0.3), 0 0 40px rgba(96,165,250,0.15);
  }
  50% {
    text-shadow: 0 0 30px rgba(37,99,235,0.5), 0 0 60px rgba(96,165,250,0.25);
  }
}

.hero h1{
font-size:clamp(3rem,5vw,5.5rem);
line-height:1.1;
font-weight:900;
letter-spacing:-3px;
margin-bottom:30px;
animation:fadeInUp 0.8s ease-out;
}

.gradient{
background:linear-gradient(
135deg,
#ffffff 0%,
#e0e7ff 25%,
#bfdbfe 50%,
#93c5fd 75%,
#2563eb 100%
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
animation:textGlow 3s ease-in-out infinite;
}

.hero p{
font-size:1.15rem;
line-height:1.9;
max-width:650px;
color:var(--muted);
margin-bottom:35px;
animation:fadeInUp 0.8s ease-out 0.2s both;
}

.buttons{
display:flex;
gap:18px;
flex-wrap:wrap;
animation:fadeInUp 0.8s ease-out 0.4s both;
}

.btn{
padding:16px 28px;
border-radius:14px;
font-weight:700;
text-decoration:none;
transition:.35s cubic-bezier(0.4,0,0.2,1);
position:relative;
overflow:hidden;
}

.btn::before{
content:"";
position:absolute;
top:0;
left:-100%;
width:100%;
height:100%;
background:rgba(255,255,255,0.2);
transition:left 0.5s ease;
}

.btn:hover::before{
left:100%;
}

.btn-primary{
background:linear-gradient(
135deg,
#2563eb,
#3b82f6
);
color:white;
box-shadow:0 4px 20px rgba(37,99,235,0.3);
}

.btn-primary:hover{
transform:translateY(-4px);
box-shadow:0 12px 40px rgba(37,99,235,0.5), 0 0 20px rgba(59,130,246,0.3);
}

.btn-secondary{
border:2px solid rgba(96,165,250,0.4);
color:white;
background:transparent;
box-shadow:0 0 20px rgba(37,99,235,0.1);
}

.btn-secondary:hover{
background:rgba(37,99,235,0.1);
border-color:rgba(96,165,250,0.7);
box-shadow:0 0 30px rgba(37,99,235,0.2);
}

/* FLOATING CARDS */

.floating{
display:flex;
flex-direction:column;
gap:24px;
}

.float-card{

background:
linear-gradient(
145deg,
rgba(191,219,254,.15) 0%,
rgba(147,197,253,.12) 20%,
rgba(96,165,250,.14) 45%,
rgba(37,99,235,.1) 70%,
rgba(15,23,42,.8) 100%
);

backdrop-filter:blur(24px);

box-shadow:
0 8px 32px rgba(37,99,235,.15),
0 0 60px rgba(59,130,246,.12),
inset 0 1px 1px rgba(255,255,255,.15);

padding:28px;

border-radius:24px;

border:1px solid rgba(96,165,250,.2);

transition:.4s cubic-bezier(0.4,0,0.2,1);

animation:fadeInUp 0.8s ease-out 0.6s both;

}

.float-card:hover{
transform:translateY(-10px) scale(1.02);
border-color:#60a5fa;
box-shadow:
0 16px 48px rgba(37,99,235,.25),
0 0 80px rgba(59,130,246,.15),
inset 0 1px 1px rgba(255,255,255,.2);
}

.float-card h3{
font-size:2rem;
margin-bottom:10px;
background:linear-gradient(
135deg,
#e0e7ff,
#93c5fd
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
}

.float-card p{
color:var(--muted);
}

/* SERVICES */

.services{
padding:120px 8%;
}

.section-title{
font-size:3.2rem;
font-weight:900;
letter-spacing:-2px;
margin-bottom:70px;
background:linear-gradient(
135deg,
#ffffff 0%,
#e0e7ff 30%,
#bfdbfe 60%,
#2563eb 100%
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
animation:fadeInUp 0.8s ease-out;
}

.services-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:30px;
}

.service-card{
position:relative;

padding:40px;

min-height:320px;

border-radius:28px;

cursor:pointer;

overflow:hidden;

transition:.45s cubic-bezier(0.4,0,0.2,1);

background:
linear-gradient(
145deg,
rgba(191,219,254,.12) 0%,
rgba(147,197,253,.1) 15%,
rgba(96,165,250,.12) 35%,
rgba(37,99,235,.15) 60%,
rgba(30,64,175,.18) 100%
);

border:1px solid rgba(96,165,250,.15);

backdrop-filter:blur(20px);

box-shadow:
0 8px 32px rgba(37,99,235,.12),
0 0 60px rgba(59,130,246,.08);

animation:fadeInUp 0.8s ease-out both;
}

.service-card:nth-child(1) {
animation-delay: 0s;
}

.service-card:nth-child(2) {
animation-delay: 0.1s;
}

.service-card:nth-child(3) {
animation-delay: 0.2s;
}

.service-card::before{
content:"";
position:absolute;
width:300px;
height:300px;
background:radial-gradient(
circle,
rgba(37,99,235,.3),
transparent 70%
);
top:-150px;
right:-100px;
opacity:0;
transition:.5s ease;
}

.service-card:hover{
transform:
translateY(-12px)
scale(1.03);

background:
linear-gradient(
145deg,
rgba(191,219,254,.2) 0%,
rgba(147,197,253,.18) 20%,
rgba(96,165,250,.2) 40%,
rgba(37,99,235,.25) 70%,
rgba(37,99,235,.2) 100%
);

box-shadow:
0 20px 60px rgba(37,99,235,.3),
0 0 100px rgba(59,130,246,.2),
inset 0 0 60px rgba(59,130,246,.05);

border-color:rgba(96,165,250,.3);
}

.service-card:hover::before{
opacity:1;
animation:pulse 2s ease-in-out infinite;
}

@keyframes pulse {
0%, 100% {
opacity: 0;
}
50% {
opacity: 1;
}
}

.service-number{
position:absolute;
right:30px;
top:20px;
font-size:5rem;
font-weight:900;
opacity:.05;
}

.service-card h3{
font-size:1.6rem;
margin-top:40px;
margin-bottom:20px;
background:linear-gradient(
135deg,
#e0e7ff,
#bfdbfe,
#93c5fd
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
transition:.3s ease;
}

.service-card:hover h3{
text-shadow:0 0 20px rgba(37,99,235,0.2);
}

.service-card p{
line-height:1.9;
color:var(--muted);
transition:.3s ease;
}

.learn{
margin-top:25px;
display:inline-block;
background:linear-gradient(
135deg,
#60a5fa,
#3b82f6
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
font-weight:700;
position:relative;
transition:.3s ease;
}

.learn::after{
content:"→";
margin-left:8px;
transition:margin-left 0.3s ease;
}

.service-card:hover .learn::after{
margin-left:12px;
}

/* STATS */

.stats{
padding:100px 8%;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:30px;
}

.stat{
text-align:center;
padding:40px;
background:linear-gradient(
135deg,
rgba(191,219,254,.08),
rgba(147,197,253,.05)
);
border-radius:24px;
border:1px solid rgba(96,165,250,.1);
backdrop-filter:blur(20px);
transition:.4s cubic-bezier(0.4,0,0.2,1);
animation:fadeInUp 0.8s ease-out both;
}

.stat:nth-child(1) {
animation-delay: 0s;
}

.stat:nth-child(2) {
animation-delay: 0.1s;
}

.stat:nth-child(3) {
animation-delay: 0.2s;
}

.stat:nth-child(4) {
animation-delay: 0.3s;
}

.stat:hover{
transform:translateY(-8px) scale(1.02);
border-color:rgba(96,165,250,.3);
background:linear-gradient(
135deg,
rgba(191,219,254,.15),
rgba(147,197,253,.1)
);
box-shadow:0 12px 40px rgba(37,99,235,.15), 0 0 30px rgba(59,130,246,.1);
}

.stat h2{
font-size:3rem;
color:#60a5fa;
margin-bottom:10px;
background:linear-gradient(
135deg,
#60a5fa,
#3b82f6
);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
}

.stat p{
margin-top:10px;
color:var(--muted);
}

@media(max-width:1000px){

.hero-grid{
grid-template-columns:1fr;
}

.services-grid{
grid-template-columns:1fr;
}

.stats{
grid-template-columns:1fr 1fr;
}

.hero{
padding-top:120px;
}

}

</style>
</head>

