  <!-- ════════════════ MOUSE EFFECTS ════════════════ -->
  <div class="mouse-follower"></div>
  <div class="mouse-glow"></div>

  <script>
    // Mouse Follower Effect
    const follower = document.querySelector('.mouse-follower');
    const glow = document.querySelector('.mouse-glow');

    document.addEventListener('mousemove', (e) => {
      follower.classList.add('active');
      glow.classList.add('active');

      follower.style.left = (e.clientX - 15) + 'px';
      follower.style.top = (e.clientY - 15) + 'px';

      glow.style.left = (e.clientX - 50) + 'px';
      glow.style.top = (e.clientY - 50) + 'px';
    });

    document.addEventListener('mouseleave', () => {
      follower.classList.remove('active');
      glow.classList.remove('active');
    });

    // Navbar scroll effect
    const navbar = document.querySelector('.navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar.style.boxShadow = 'var(--shadow-md)';
      } else {
        navbar.style.boxShadow = 'var(--shadow-sm)';
      }
    });

    // Interactive card effects
    const cards = document.querySelectorAll('.value-card, .team-card, .highlight-item');
    cards.forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-8px) scale(1.02)';
      });
      card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
      });
    });
  </script>
