---
// src/pages/about.astro
import Layout from "./layout.astro";
---

<Layout
  title="About | Kanbir Solutions"
  description="Who we are — Kanbir Solutions, your trusted financial and business consulting partner."
>

<style>
  /* ─── PAGE-SPECIFIC STYLES ─── */

  /* Stats bar */
  .about-stats {
    display: flex;
    gap: 48px;
    margin-top: 48px;
    flex-wrap: wrap;
  }
  .about-stat-num {
    font-family: var(--f-serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--c-white);
    line-height: 1;
    margin-bottom: 4px;
  }
  .about-stat-label {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--c-white-35);
    letter-spacing: 0.04em;
  }
  .about-stat-divider {
    width: 1px;
    background: var(--c-border);
    align-self: stretch;
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .pillar-card {
    background: var(--c-surface);
    padding: 40px 36px;
    transition: background var(--t-mid) var(--ease);
    position: relative;
    overflow: hidden;
  }
  .pillar-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(37,99,235,0.4), transparent);
    opacity: 0;
    transition: opacity var(--t-mid) var(--ease);
  }
  .pillar-card:hover { background: var(--c-surface-2); }
  .pillar-card:hover::before { opacity: 1; }
  .pillar-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-blue-bright);
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 8px;
  }
  .pillar-num::before {
    content: '';
    width: 20px; height: 1px;
    background: var(--c-blue-bright);
  }
  .pillar-card h3 {
    font-family: var(--f-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--c-white);
    margin-bottom: 12px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .pillar-card p {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.75;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 32px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0; top: 8px; bottom: 8px;
    width: 1px;
    background: linear-gradient(to bottom, var(--c-blue), rgba(37,99,235,0.1));
  }
  .timeline-item {
    position: relative;
    padding-bottom: 40px;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-dot {
    position: absolute;
    left: -36px; top: 4px;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--c-blue);
    box-shadow: 0 0 0 3px var(--c-bg), 0 0 12px var(--c-blue);
  }
  .timeline-year {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-blue-bright);
    margin-bottom: 6px;
  }
  .timeline-item h4 {
    font-family: var(--f-serif);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--c-white);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }
  .timeline-item p {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.65;
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .value-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 28px 24px;
    transition: all var(--t-mid) var(--ease);
  }
  .value-card:hover {
    border-color: var(--c-border-hover);
    background: var(--c-surface-2);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .value-icon {
    font-size: 1.4rem;
    margin-bottom: 14px;
    display: block;
    filter: grayscale(0.2);
  }
  .value-card h4 {
    font-family: var(--f-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-white);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .value-card p {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.65;
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .testi-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 28px 24px;
    transition: all var(--t-mid) var(--ease);
    position: relative;
  }
  .testi-card:hover {
    border-color: var(--c-border-hover);
    box-shadow: var(--shadow-hover);
  }
  .testi-quote {
    font-family: var(--f-serif);
    font-size: 2rem;
    font-style: italic;
    color: var(--c-blue-bright);
    line-height: 1;
    margin-bottom: 12px;
    opacity: 0.6;
  }
  .testi-card blockquote {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.7;
    margin-bottom: 20px;
    font-style: italic;
  }
  .testi-author {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .testi-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-blue), var(--c-blue-bright));
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .testi-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-white-90);
    line-height: 1.3;
  }
  .testi-role {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--c-white-35);
  }

  /* CTA band */
  .about-cta {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 64px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .about-cta::before {
    content: '';
    position: absolute;
    top: -60%; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 300px;
    background: radial-gradient(ellipse, rgba(37,99,235,0.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .about-cta h2 {
    font-family: var(--f-serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    color: var(--c-white);
    margin-bottom: 14px;
    letter-spacing: -0.02em;
    position: relative;
  }
  .about-cta p {
    font-size: 1rem;
    font-weight: 300;
    color: var(--c-white-60);
    max-width: 480px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }
  .about-cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    position: relative;
  }

  /* 2-col layout for about */
  .about-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Accounting visual accent */
  .accounting-visual {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    position: relative;
  }
  .accounting-visual img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity var(--t-slow) var(--ease);
  }
  .accounting-visual:hover img { opacity: 0.9; }
  .accounting-visual-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 24px;
    background: linear-gradient(to top, rgba(6,13,31,0.95) 0%, transparent 100%);
  }
  .accounting-visual-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-blue-bright);
    margin-bottom: 4px;
  }
  .accounting-visual-label {
    font-family: var(--f-serif);
    font-size: 1.1rem;
    color: var(--c-white);
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .pillars-grid { grid-template-columns: 1fr; }
    .values-grid { grid-template-columns: 1fr 1fr; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .about-two-col { grid-template-columns: 1fr; gap: 48px; }
    .about-cta { padding: 48px 32px; }
  }
  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
    .about-stats { gap: 24px; }
    .about-stat-divider { display: none; }
  }
</style>

<!-- ══ PAGE HEADER ══ -->
<div class="kb-page-header">
  <div class="kb-page-header-inner">
    <div class="kb-page-eyebrow">Who We Are</div>
    <h1 class="kb-page-title">
      Building financial confidence<br />
      for <strong>ambitious businesses.</strong>
    </h1>
    <p class="kb-page-lead">
      We're more than service providers — we're committed partners dedicated to driving your business's success through financial intelligence, operational precision, and long-term relationship thinking.
    </p>
    <div class="about-stats">
      <div>
        <div class="about-stat-num">500+</div>
        <div class="about-stat-label">Clients Supported</div>
      </div>
      <div class="about-stat-divider"></div>
      <div>
        <div class="about-stat-num">£40M+</div>
        <div class="about-stat-label">R&D Claims & Savings</div>
      </div>
      <div class="about-stat-divider"></div>
      <div>
        <div class="about-stat-num">15+</div>
        <div class="about-stat-label">Years Experience</div>
      </div>
      <div class="about-stat-divider"></div>
      <div>
        <div class="about-stat-num">98%</div>
        <div class="about-stat-label">Client Retention</div>
      </div>
    </div>
  </div>
</div>

<div class="kb-divider"></div>

<!-- ══ PILLARS ══ -->
<section class="kb-section" style="background: var(--c-bg);">
  <div class="kb-section-inner">
    <div class="about-two-col" style="margin-bottom: 64px;">
      <div>
        <div class="kb-section-label">Our Philosophy</div>
        <h2 class="kb-section-heading">
          A holistic approach<br />to <em>growth.</em>
        </h2>
        <p class="kb-section-sub" style="margin-bottom: 28px;">
          Success demands a blend of strategic planning and operational precision. We combine deep expertise in Accounting, ERP, Business Analysis, and IT to craft holistic, scalable solutions.
        </p>
        <a href="/services" class="kb-btn-outline" style="margin-top: 8px;">
          Explore our services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="accounting-visual kb-reveal">
        <img
          src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=900&q=80"
          alt="Financial strategy planning with charts and data"
          loading="lazy"
          width="900" height="675"
        />
        <div class="accounting-visual-overlay">
          <div class="accounting-visual-tag">Strategic Finance</div>
          <div class="accounting-visual-label">Planning for scale</div>
        </div>
      </div>
    </div>

    <div class="pillars-grid">
      <div class="pillar-card kb-reveal" data-delay="0">
        <div class="pillar-num">01</div>
        <h3>Your Trusted Business Partner</h3>
        <p>Our team of seasoned experts collaborates closely with clients to ensure both financial and operational efficiency. By aligning with your goals, we help you tackle today's challenges while preparing for tomorrow's opportunities.</p>
      </div>
      <div class="pillar-card kb-reveal" data-delay="80">
        <div class="pillar-num">02</div>
        <h3>A Holistic Approach to Growth</h3>
        <p>We combine deep expertise in Accounting, ERP, Business Analysis, and IT to craft holistic, scalable solutions — whether optimising processes, navigating regulatory complexities, or leveraging technology for growth.</p>
      </div>
      <div class="pillar-card kb-reveal" data-delay="160">
        <div class="pillar-num">03</div>
        <h3>Tailored Solutions for Every Stage</h3>
        <p>From startups laying their foundations to enterprises exploring global markets, we provide bespoke services designed to meet unique business needs — adapting strategy to your scale, industry, and ambitions.</p>
      </div>
      <div class="pillar-card kb-reveal" data-delay="240">
        <div class="pillar-num">04</div>
        <h3>Innovation Meets Expertise</h3>
        <p>We leverage cutting-edge technology, industry best practices, and decades of experience — integrating advanced ERP systems, streamlining financial management, and offering actionable business insights.</p>
      </div>
    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ JOURNEY ══ -->
<section class="kb-section" style="background: var(--c-bg-2);">
  <div class="kb-section-inner">
    <div class="about-two-col">
      <div>
        <div class="kb-section-label">Our Journey</div>
        <h2 class="kb-section-heading">
          How Kanbir evolved<br />to serve <em>modern finance.</em>
        </h2>
        <p class="kb-section-sub">
          Over 15 years, we've grown from a focused accounting practice into a premium financial intelligence and transformation partner.
        </p>
      </div>
      <div class="timeline">
        <div class="timeline-item kb-reveal" data-delay="0">
          <div class="timeline-dot"></div>
          <div class="timeline-year">2009</div>
          <h4>Founded</h4>
          <p>Started with a simple mission: make accounting smarter for growth companies.</p>
        </div>
        <div class="timeline-item kb-reveal" data-delay="100">
          <div class="timeline-dot"></div>
          <div class="timeline-year">2013</div>
          <h4>ERP Expertise</h4>
          <p>Expanded into ERP integration and systems optimisation for scaling teams — SAP, Oracle, Sage, QuickBooks.</p>
        </div>
        <div class="timeline-item kb-reveal" data-delay="200">
          <div class="timeline-dot"></div>
          <div class="timeline-year">2018</div>
          <h4>R&D Leadership</h4>
          <p>Became specialists in R&D tax credits, recovering £40M+ for innovative UK businesses.</p>
        </div>
        <div class="timeline-item kb-reveal" data-delay="300">
          <div class="timeline-dot"></div>
          <div class="timeline-year">2024</div>
          <h4>Strategic Partnership</h4>
          <p>Evolved into a premium financial intelligence and transformation partner for ambitious leaders nationwide.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ VALUES ══ -->
<section class="kb-section" style="background: var(--c-bg);">
  <div class="kb-section-inner">
    <div style="text-align: center; max-width: 560px; margin: 0 auto 56px;">
      <div class="kb-section-label" style="justify-content: center;">Our Values</div>
      <h2 class="kb-section-heading">What guides <em>everything</em> we do.</h2>
      <p class="kb-section-sub" style="margin: 0 auto;">
        Our values aren't words on a wall. They shape how we hire, advise, and show up for our clients every day.
      </p>
    </div>
    <div class="values-grid">
      <div class="value-card kb-reveal" data-delay="0">
        <span class="value-icon" aria-hidden="true">🎯</span>
        <h4>Clear Strategy</h4>
        <p>No jargon, no confusion. We translate complex finance into actionable strategy your team can execute.</p>
      </div>
      <div class="value-card kb-reveal" data-delay="80">
        <span class="value-icon" aria-hidden="true">⚡</span>
        <h4>Fast Execution</h4>
        <p>Speed matters in business. Our teams move at the pace of ambitious, high-growth organisations.</p>
      </div>
      <div class="value-card kb-reveal" data-delay="160">
        <span class="value-icon" aria-hidden="true">🔐</span>
        <h4>Trust First</h4>
        <p>Built on compliance, transparency, and long-term partnership thinking that never cuts corners.</p>
      </div>
      <div class="value-card kb-reveal" data-delay="240">
        <span class="value-icon" aria-hidden="true">📊</span>
        <h4>Data-Driven</h4>
        <p>Every insight is backed by data. Financial intelligence that informs every leadership decision.</p>
      </div>
      <div class="value-card kb-reveal" data-delay="320">
        <span class="value-icon" aria-hidden="true">🌱</span>
        <h4>Growth Minded</h4>
        <p>We succeed when you scale. Growth is at the heart of every strategy, model, and recommendation.</p>
      </div>
      <div class="value-card kb-reveal" data-delay="400">
        <span class="value-icon" aria-hidden="true">🤝</span>
        <h4>Partnership</h4>
        <p>We're an extension of your team, not a vendor. Deep, collaborative, long-term relationships.</p>
      </div>
    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ TESTIMONIALS ══ -->
<section class="kb-section" style="background: var(--c-bg-2);">
  <div class="kb-section-inner">
    <div style="text-align: center; max-width: 560px; margin: 0 auto 48px;">
      <div class="kb-section-label" style="justify-content: center;">Client Voice</div>
      <h2 class="kb-section-heading">How leaders describe <em>working with Kanbir.</em></h2>
    </div>
    <div class="testimonials-grid">
      <div class="testi-card kb-reveal" data-delay="0">
        <div class="testi-quote">"</div>
        <blockquote>Kanbir transformed our financial operations. Within 6 months, we had visibility into cash flow, optimised our ERP, and recovered £280K in R&D claims.</blockquote>
        <div class="testi-author">
          <div class="testi-avatar" aria-hidden="true">SC</div>
          <div>
            <div class="testi-name">Sarah Chen</div>
            <div class="testi-role">CFO, TechScale</div>
          </div>
        </div>
      </div>
      <div class="testi-card kb-reveal" data-delay="100">
        <div class="testi-quote">"</div>
        <blockquote>Not just accountants. They're strategic partners who understand our growth trajectory and plan accordingly with genuine care.</blockquote>
        <div class="testi-author">
          <div class="testi-avatar" aria-hidden="true">JM</div>
          <div>
            <div class="testi-name">James Murphy</div>
            <div class="testi-role">Founder, GrowthCo</div>
          </div>
        </div>
      </div>
      <div class="testi-card kb-reveal" data-delay="200">
        <div class="testi-quote">"</div>
        <blockquote>Finally, someone who speaks our language. They get ERP complexity and helped us avoid a £1.2M mistake in implementation.</blockquote>
        <div class="testi-author">
          <div class="testi-avatar" aria-hidden="true">PP</div>
          <div>
            <div class="testi-name">Priya Patel</div>
            <div class="testi-role">COO, ManufacturePro</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ CTA ══ -->
<section class="kb-section" style="background: var(--c-bg);">
  <div class="kb-section-inner">
    <div class="about-cta kb-reveal">
      <h2>Ready to build a smarter financial operating model?</h2>
      <p>Let's explore how Kanbir can accelerate your growth, optimise your systems, and unlock financial intelligence that moves at your speed.</p>
      <div class="about-cta-actions">
        <a href="#" class="kb-btn-primary">
          Book a Strategy Call
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/services" class="kb-btn-outline">Explore Services</a>
      </div>
    </div>
  </div>
</section>

</Layout>