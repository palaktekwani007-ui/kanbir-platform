---
// src/pages/services.astro
import Layout from "./layout.astro";
---

<Layout
  title="Services | Kanbir Solutions"
  description="Kanbir Solutions Services: accounting, tax, ERP integration, business advisory and R&D claims for ambitious UK businesses."
>

<style>
  /* ─── SERVICES PAGE STYLES ─── */

  /* Hero feature cards row */
  .services-hero-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 52px;
  }
  .hero-feat-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 20px;
    transition: all var(--t-mid) var(--ease);
  }
  .hero-feat-card:hover {
    border-color: var(--c-border-hover);
    background: var(--c-surface-2);
    transform: translateY(-2px);
  }
  .hero-feat-icon {
    font-size: 1.2rem;
    margin-bottom: 10px;
    display: block;
  }
  .hero-feat-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-white-90);
    margin-bottom: 4px;
  }
  .hero-feat-desc {
    font-size: 0.78rem;
    font-weight: 300;
    color: var(--c-white-35);
    line-height: 1.5;
  }

  /* Main services list */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .service-row {
    background: var(--c-surface);
    display: grid;
    grid-template-columns: 80px 1fr 1fr auto;
    gap: 40px;
    align-items: start;
    padding: 40px 44px;
    transition: background var(--t-mid) var(--ease);
    position: relative;
    overflow: hidden;
  }
  .service-row::after {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--c-blue), var(--c-blue-bright));
    opacity: 0;
    transition: opacity var(--t-mid) var(--ease);
  }
  .service-row:hover { background: var(--c-surface-2); }
  .service-row:hover::after { opacity: 1; }
  .service-num {
    font-family: var(--f-serif);
    font-size: 1.8rem;
    font-weight: 400;
    color: rgba(37,99,235,0.2);
    line-height: 1;
    padding-top: 4px;
    letter-spacing: -0.04em;
    transition: color var(--t-mid) var(--ease);
  }
  .service-row:hover .service-num { color: rgba(37,99,235,0.5); }
  .service-main h3 {
    font-family: var(--f-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--c-white);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .service-main p {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.75;
  }
  .service-details {
    padding-top: 4px;
  }
  .service-detail-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-blue-bright);
    margin-bottom: 10px;
  }
  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .service-tag {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--c-white-60);
    padding: 4px 10px;
    background: var(--c-white-06);
    border: 1px solid var(--c-border);
    border-radius: var(--r-full);
  }
  .service-icon-large {
    width: 52px; height: 52px;
    border-radius: var(--r-md);
    background: rgba(37,99,235,0.1);
    border: 1px solid rgba(37,99,235,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
    transition: all var(--t-mid) var(--ease);
  }
  .service-row:hover .service-icon-large {
    background: rgba(37,99,235,0.2);
    border-color: rgba(37,99,235,0.4);
  }

  /* Accounting image visual */
  .accounting-img-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .accounting-img-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    position: relative;
  }
  .accounting-img-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity var(--t-slow) var(--ease), transform var(--t-slow) var(--ease);
  }
  .accounting-img-card:hover img { opacity: 0.9; transform: scale(1.03); }
  .accounting-img-caption {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 12px 16px;
    background: linear-gradient(to top, rgba(6,13,31,0.9) 0%, transparent 100%);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--c-white-60);
  }

  /* Stats row */
  .services-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .services-stat {
    background: var(--c-surface);
    padding: 36px 32px;
    transition: background var(--t-mid) var(--ease);
  }
  .services-stat:hover { background: var(--c-surface-2); }
  .services-stat-num {
    font-family: var(--f-serif);
    font-size: 2.4rem;
    font-weight: 400;
    color: var(--c-white);
    line-height: 1;
    margin-bottom: 6px;
    letter-spacing: -0.03em;
  }
  .services-stat-label {
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--c-white-35);
    line-height: 1.4;
  }

  /* Process */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .process-step {
    background: var(--c-surface);
    padding: 36px 28px;
    position: relative;
    transition: background var(--t-mid) var(--ease);
  }
  .process-step:hover { background: var(--c-surface-2); }
  .process-step-line {
    position: absolute;
    top: 47px; left: 64px; right: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(37,99,235,0.4), transparent);
  }
  .process-step:last-child .process-step-line { display: none; }
  .process-step-num {
    width: 36px; height: 36px;
    border-radius: var(--r-sm);
    background: rgba(37,99,235,0.12);
    border: 1px solid rgba(37,99,235,0.25);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-blue-bright);
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    transition: all var(--t-mid) var(--ease);
  }
  .process-step:hover .process-step-num {
    background: var(--c-blue);
    border-color: var(--c-blue);
    color: #fff;
    box-shadow: 0 4px 16px rgba(37,99,235,0.4);
  }
  .process-step h4 {
    font-family: var(--f-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-white);
    margin-bottom: 8px;
  }
  .process-step p {
    font-size: 0.825rem;
    font-weight: 300;
    color: var(--c-white-60);
    line-height: 1.65;
  }

  /* CTA */
  .services-cta {
    background: linear-gradient(135deg, var(--c-blue) 0%, #1d4ed8 40%, var(--c-bg-2) 100%);
    border-radius: var(--r-xl);
    padding: 72px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .services-cta::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 50% -20%, rgba(255,255,255,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 90% 80%, rgba(255,255,255,0.05) 0%, transparent 50%);
    pointer-events: none;
  }
  .services-cta h2 {
    font-family: var(--f-serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    color: var(--c-white);
    margin-bottom: 14px;
    letter-spacing: -0.02em;
    position: relative;
  }
  .services-cta p {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(255,255,255,0.7);
    max-width: 500px;
    margin: 0 auto 36px;
    line-height: 1.7;
    position: relative;
  }
  .services-cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    position: relative;
  }
  .btn-cta-white {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--f-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-blue);
    background: var(--c-white);
    padding: 13px 28px;
    border-radius: var(--r-md);
    border: none;
    cursor: pointer;
    transition: all var(--t-mid) var(--ease);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }
  .btn-cta-white:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
  .btn-cta-ghost-white {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--f-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    background: transparent;
    padding: 12px 28px;
    border-radius: var(--r-md);
    border: 1px solid rgba(255,255,255,0.25);
    cursor: pointer;
    transition: all var(--t-mid) var(--ease);
  }
  .btn-cta-ghost-white:hover { color: #fff; border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.08); }

  /* Section with image+list split */
  .services-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .services-split.reverse { direction: rtl; }
  .services-split.reverse > * { direction: ltr; }

  @media (max-width: 1024px) {
    .service-row { grid-template-columns: 60px 1fr; gap: 24px; }
    .service-details { display: none; }
    .service-icon-large { display: none; }
    .services-hero-cards { grid-template-columns: repeat(2, 1fr); }
    .accounting-img-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .services-stats { grid-template-columns: repeat(2, 1fr); }
    .process-steps { grid-template-columns: repeat(2, 1fr); }
    .services-split { grid-template-columns: 1fr; gap: 40px; }
    .services-split.reverse { direction: ltr; }
  }
  @media (max-width: 600px) {
    .services-hero-cards { grid-template-columns: 1fr; }
    .process-steps { grid-template-columns: 1fr; }
    .services-cta { padding: 48px 24px; }
    .service-row { padding: 28px 24px; }
  }
</style>

<!-- ══ PAGE HEADER ══ -->
<div class="kb-page-header">
  <div class="kb-page-header-inner">
    <div class="kb-page-eyebrow">Our Services</div>
    <h1 class="kb-page-title">
      Strategy-led finance, bookkeeping<br />
      and advisory <strong>built to grow your business.</strong>
    </h1>
    <p class="kb-page-lead">
      Kanbir Solutions helps scaleups and high-growth firms simplify accounting, unlock tax savings, integrate ERP systems and claim R&D relief — with confidence and precision.
    </p>
    <div class="services-hero-cards" style="margin-top: 48px;">
      <div class="hero-feat-card">
        <span class="hero-feat-icon" aria-hidden="true">📘</span>
        <div class="hero-feat-title">Accounting built for growth</div>
        <div class="hero-feat-desc">Cloud-native bookkeeping and KPI dashboards that keep leaders aligned.</div>
      </div>
      <div class="hero-feat-card">
        <span class="hero-feat-icon" aria-hidden="true">🧾</span>
        <div class="hero-feat-title">Tax and compliance clarity</div>
        <div class="hero-feat-desc">End-to-end tax planning and HMRC compliance with proactive advice.</div>
      </div>
      <div class="hero-feat-card">
        <span class="hero-feat-icon" aria-hidden="true">⚙️</span>
        <div class="hero-feat-title">ERP adoption without friction</div>
        <div class="hero-feat-desc">Practical systems integration to unify sales, finance and operations.</div>
      </div>
      <div class="hero-feat-card">
        <span class="hero-feat-icon" aria-hidden="true">📈</span>
        <div class="hero-feat-title">Data-driven business advisory</div>
        <div class="hero-feat-desc">Financial modelling and strategic guidance for your next stage of growth.</div>
      </div>
    </div>
  </div>
</div>

<div class="kb-divider"></div>

<!-- ══ SERVICES LIST ══ -->
<section class="kb-section" style="background: var(--c-bg);">
  <div class="kb-section-inner">
    <div style="margin-bottom: 40px;">
      <div class="kb-section-label">What We Offer</div>
      <h2 class="kb-section-heading">Services designed around <em>your business lifecycle.</em></h2>
      <p class="kb-section-sub">From startup finance to international expansion, we combine expert accounting, tax, ERP and advisory services for every stage of your journey.</p>
    </div>

    <div class="services-list">

      <div class="service-row kb-reveal">
        <div class="service-num">01</div>
        <div class="service-main">
          <h3>ERP System Integration</h3>
          <p>We specialise in seamlessly integrating ERP systems such as SAP, Oracle, Sage, and QuickBooks into your business processes. Our approach ensures automation of repetitive tasks, streamlining workflows, and enhancing operational efficiency. Whether implementing a new system or upgrading an existing one, our team ensures a smooth transition with minimal disruption.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Platforms</div>
          <div class="service-tags">
            <span class="service-tag">SAP</span>
            <span class="service-tag">Oracle</span>
            <span class="service-tag">Sage</span>
            <span class="service-tag">QuickBooks</span>
            <span class="service-tag">Xero</span>
            <span class="service-tag">Microsoft Dynamics</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">⚙️</div>
      </div>

      <div class="service-row kb-reveal">
        <div class="service-num">02</div>
        <div class="service-main">
          <h3>Business Advisory Services</h3>
          <p>Navigating the complexities of business growth requires strategic insights, and our advisory services guide you every step of the way. From developing effective market entry strategies to supporting mergers and acquisitions, we provide actionable solutions tailored to your unique needs — combining in-depth industry knowledge with data-driven analysis to identify opportunities and mitigate risks.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Focus Areas</div>
          <div class="service-tags">
            <span class="service-tag">Market Entry</span>
            <span class="service-tag">M&A Support</span>
            <span class="service-tag">Financial Modelling</span>
            <span class="service-tag">Cash Flow Planning</span>
            <span class="service-tag">KPI Strategy</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">📈</div>
      </div>

      <div class="service-row kb-reveal">
        <div class="service-num">03</div>
        <div class="service-main">
          <h3>Accounting & Bookkeeping</h3>
          <p>Accurate financial records are the foundation of a healthy business. Our comprehensive bookkeeping solutions ensure your finances remain clean, organised, and compliant. We offer both onsite and remote services, handling everything from recording transactions to reconciling accounts — delivering timely, precise financial reports that give you a clear picture of your business's financial health.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Includes</div>
          <div class="service-tags">
            <span class="service-tag">Real-time Ledgers</span>
            <span class="service-tag">Month-end Close</span>
            <span class="service-tag">Reconciliation</span>
            <span class="service-tag">GAAP/IFRS</span>
            <span class="service-tag">Management Reports</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">📘</div>
      </div>

      <div class="service-row kb-reveal">
        <div class="service-num">04</div>
        <div class="service-main">
          <h3>Compliance & Taxation Support</h3>
          <p>Managing tax obligations and ensuring compliance can be challenging, but our expert services make the process simple and stress-free. We assist with tax returns, VAT submissions, audits, and other regulatory requirements — ensuring you stay fully compliant with local and international laws. Our proactive approach identifies potential issues early and minimises the risk of penalties.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Coverage</div>
          <div class="service-tags">
            <span class="service-tag">Corporate Tax</span>
            <span class="service-tag">VAT Returns</span>
            <span class="service-tag">HMRC Compliance</span>
            <span class="service-tag">Payroll Tax</span>
            <span class="service-tag">International Tax</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">🧾</div>
      </div>

      <div class="service-row kb-reveal">
        <div class="service-num">05</div>
        <div class="service-main">
          <h3>R&D Claims Support</h3>
          <p>Research and development activities can unlock significant tax benefits, and we are here to help you maximise your R&D tax credits. Our team identifies eligible projects and expenses, ensuring no opportunity is overlooked. We manage the claims process from start to finish — including documentation, submissions, and liaising with tax authorities — so you can focus on innovation.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Track Record</div>
          <div class="service-tags">
            <span class="service-tag">£40M+ Recovered</span>
            <span class="service-tag">Audit-ready Docs</span>
            <span class="service-tag">HMRC Liaison</span>
            <span class="service-tag">SME & RDEC</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">🔬</div>
      </div>

      <div class="service-row kb-reveal">
        <div class="service-num">06</div>
        <div class="service-main">
          <h3>International Finance</h3>
          <p>Multi-jurisdictional support for UK companies operating overseas and overseas businesses entering the UK market. We provide cross-border tax planning, transfer pricing advice, entity structuring, and financial reporting that meets the requirements of every territory you operate in.</p>
        </div>
        <div class="service-details">
          <div class="service-detail-label">Scope</div>
          <div class="service-tags">
            <span class="service-tag">Cross-border Tax</span>
            <span class="service-tag">Transfer Pricing</span>
            <span class="service-tag">Entity Structure</span>
            <span class="service-tag">UK Market Entry</span>
          </div>
        </div>
        <div class="service-icon-large" aria-hidden="true">🌍</div>
      </div>

    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ STATS ══ -->
<section class="kb-section" style="background: var(--c-bg-2);">
  <div class="kb-section-inner">
    <div style="text-align: center; margin-bottom: 48px;">
      <div class="kb-section-label" style="justify-content: center;">Why Kanbir</div>
      <h2 class="kb-section-heading" style="text-align: center;">Focus on growth, <em>not process.</em></h2>
      <p class="kb-section-sub" style="margin: 0 auto; text-align: center;">We bring the clarity, structure and systems that let leadership focus on customers while finance runs smoothly behind the scenes.</p>
    </div>
    <div class="services-stats">
      <div class="services-stat kb-reveal" data-delay="0">
        <div class="services-stat-num">500+</div>
        <div class="services-stat-label">Businesses supported across manufacturing, tech, retail and professional services</div>
      </div>
      <div class="services-stat kb-reveal" data-delay="80">
        <div class="services-stat-num">15+</div>
        <div class="services-stat-label">Years of combined experience in UK accounting, taxation and ERP transformation</div>
      </div>
      <div class="services-stat kb-reveal" data-delay="160">
        <div class="services-stat-num">£40M+</div>
        <div class="services-stat-label">R&D tax relief recovered for clients across ambitious scaleups and enterprises</div>
      </div>
      <div class="services-stat kb-reveal" data-delay="240">
        <div class="services-stat-num">24/7</div>
        <div class="services-stat-label">Support through fast-moving financial deadlines and growth cycles</div>
      </div>
    </div>
  </div>
</section>

<div class="kb-divider"></div>

<!-- ══ ACCOUNTING IMAGE GALLERY ══ -->
<section class="kb-section" style="background: var(--c-bg);">
  <div class="kb-section-inner">
    <div class="services-split">
      <div>
        <div class="kb-section-label">Precision at Work</div>
        <h2 class="kb-section-heading">Financial operations that <em>run flawlessly.</em></h2>
        <p class="kb-section-sub" style="margin-bottom: 28px;">
          Our team embeds itself into your financial workflows — from real-time bookkeeping to board-level reporting — ensuring every number is accurate, every deadline is met, and every opportunity is captured.
        </p>
        <a href="/contact" class="kb-btn-primary">
          Talk to an expert
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="accounting-img-grid kb-reveal">
        <div class="accounting-img-card">
          <img
            src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=700&q=80"
            alt="Accountant reviewing financial statements and ledgers"
            loading="lazy" width="700" height="525"
          />
          <div class="accounting-img-caption">Tax Planning</div>
        </div>
        <div class="accounting-img-card">
          <img
            src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=700&q=80"
            alt="ERP dashboard showing financial KPIs"
            loading="lazy" width="700" height="525"
          />
          <div class="accounting-img-caption">ERP Intelligence</div>
        </div>
        <div class="accounting-img-card">
          <img
            src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=700&q=80"
            alt="Business advisory meeting with financial charts"
            loading="lazy" width="700" height="525"
          />
          <div class="accounting-img-caption">Business Advisory</div>
        </div>
        <div class="accounting-img-card">
          <img
            src="https://images.unsplash.com/photo-1543286386-713bdd548da4?auto=format&fit=crop&w=700&q=80"
            alt="R&D financial documents and research planning"
            loading="lazy" width="700" height="525"
          />
          <div class="accounting-img-caption">R&D Claims</div>
        </div>
      </div>
    </div>
  </div>
